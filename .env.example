# Copia este archivo como .env y cambia los valores. El archivo .env no se sube a GitHub.

# Contraseñas de MySQL (no hace falta recordarlas)
DB_PASSWORD=cambia-esto
DB_ROOT_PASSWORD=cambia-esto-tambien

# Clave para firmar las sesiones: larga y aleatoria (por ejemplo: openssl rand -hex 32)
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Administrador que se crea la primera vez
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esto

# Email de contacto para las notificaciones push
APP_CONTACTO=mailto:tu-email@gmail.com

# Email (opcional, para los avisos por correo)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
